# Zeitzone für Zeitstempel, z. B. Europe/Berlin
TZ=Europe/Berlin
# Öffentliche Browser-Adresse von m0BamboSpool
HOST_IP=localhost
M0BAMBOSPOOL_BASE_PORT=8000
# Spoolman-Adresse; extern meist http://localhost:7912
SPOOLMAN_BASE_PORT=7912
# Interne Docker-Adresse von Spoolman
SPOOLMAN_INTERNAL_BASE_URL=http://spoolman:8000
# Inventar-Backend: yes = Spoolman (Standard), no = lokale m0BamboSpool-Verwaltung
USE_SPOOLMAN=yes

# Existing m0BamboSpool parameters continue below / can be overridden in config.env.

# m0BamboSpool database configuration
M0BAMBOSPOOL_DATABASE_TYPE=sqlite
M0BAMBOSPOOL_DATABASE_NAME=osm.db
# Optional full path override. The legacy M0BAMBOSPOOL_PRINT_HISTORY_DB name is still accepted.
M0BAMBOSPOOL_DATABASE_PATH=

# AMS-Logmodus: none (aus), changes (nur Änderungen), everything (alles)
LOG_AMS_MODE=changes
# Drucker-IP (für die Druckerverbindung immer erforderlich)
PRINTER_IP=
# Druckerverbindungsmodus: ONLINE oder LAN
PRINTER_CONNECTION_MODE=LAN
# Drucker-Seriennummer
PRINTER_ID=
# Anzeigename des Druckers
PRINTER_NAME=
# LAN-/Developer-Mode-Zugangscode
PRINTER_ACCESS_LAN=
# Online-/Cloud-Zugangscode
PRINTER_ACCESS_ONLINE=

# Print tracking and logging
# Spulensortierung als kommaseparierte Feldliste
SPOOL_SORTING=filament.material:asc,filament.vendor.name:asc,filament.name:asc
# Farbabstandstoleranz: positive Ganzzahl, höher = toleranter
COLOR_DISTANCE_TOLERANCE=40
